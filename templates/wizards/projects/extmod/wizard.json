{
    "version": 1,
    "supportedProjectTypes": [ "CMakeProjectManager.CMakeProject" ],
    "id": "R.Fortran F2PY Extension",
    "category": "I.Projects",
    "trDescription": "Creates a Fortran F2PY extension module skeleton.",
    "trDisplayName": "Fortran F2PY Extension",
    "trDisplayCategory": "Non-Qt Project",
    "icon": "../../global/consoleapplication.png",
    "enabled": "%{JS: value('Plugins').indexOf('CMakeProjectManager') >= 0}",

    "options":
    [
        { "key": "ProjectFile", "value": "%{ProjectDirectory}/CMakeLists.txt" }
    ],

    "pages":
    [
        {
            "trDisplayName": "Project Location",
            "trShortTitle": "Location",
            "typeId": "Project"
        },
        {
            "trDisplayName": "Module name",
            "trShortTitle": "Module",
            "typeId": "Fields",
            "data":
            [
                {
                    "name": "ModuleName",
                    "type": "LineEdit",
                    "trDisplayName": "Module name:",
                    "mandatory": true,
                    "data": {"trText": "extmod"}
                }
            ]
        },
        {
            "trDisplayName": "Kit Selection",
            "trShortTitle": "Kits",
            "typeId": "Kits",
            "enabled": "%{JS: ! %{IsSubproject}}",
            "data": { "projectFilePath": "%{ProjectFile}" }
        },
        {
            "trDisplayName": "Project Management",
            "trShortTitle": "Summary",
            "typeId": "Summary"
        }
    ],
    "generators":
    [
        {
            "typeId": "File",
            "data":
            [
                {
                    "source": "CMakeLists.txt",
                    "openAsProject": true
                },
                {
                    "source": "extmodule_const.f90",
                    "target": "%{ModuleName}_const.f90",
                    "openInEditor": true
                },
                {
                    "source": "extmodule_intf.f90",
                    "target": "%{ModuleName}_intf.f90",
                    "openInEditor": true
                },
                {
                    "source": "extmodule_impl.f90",
                    "target": "%{ModuleName}_impl.f90",
                    "openInEditor": true
                },
                {
                    "source": "f2py_f2cmap",
                    "target": ".f2py_f2cmap"
                },
                {
                    "source": "../git.ignore",
                    "target": ".gitignore",
                    "condition": "%{JS: ! %{IsSubproject} && '%{VersionControl}' === 'G.Git'}"
                }
            ]
        }
    ]
}
